# Machine-local experiments and test output must never be published.
/local-tests/

# Raw run artifacts are local; publish reviewed summaries in docs/execution/.
/artifacts/
/coverage/

# Only README.md is published; other Markdown and agent instructions stay local.
*.[mM][dD]
!README.md

# Generated dependency and build output.
**/target/
**/node_modules/

# Local environment files; sanitized examples remain shareable.
.env
.env.*
!.env.example
!.env.*.example

# Operating-system metadata.
.DS_Store
Thumbs.db
desktop.ini
